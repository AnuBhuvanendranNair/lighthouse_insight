{
    "name": "anubit/typo3-lighthouse-insight",
    "type": "typo3-cms-extension",
    "description": "Run Google PageSpeed Insights analyses from the TYPO3 backend.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">= 8.1 < 8.6",
        "symfony/process": "^7.4",
        "typo3/cms-backend": "^13.4 ||^14.3",
        "typo3/cms-core": "^13.4 ||^14.3",
        "typo3/cms-fluid": "^13.4 ||^14.3"
    },
    "autoload": {
        "psr-4": {
            "Anubit\\LighthouseInsight\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anubit\\LighthouseInsight\\Tests\\": "Tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "lighthouse_insight"
        }
    }
}
